[Unit]
Description=fleet panel
After=network-online.target fleet-bridge.service
Wants=network-online.target
Requires=fleet-bridge.service

[Service]
Type=simple
User=opc
Group=opc
WorkingDirectory=/opt/panel/app
EnvironmentFile=/etc/panel/env
Environment=PYTHONPATH=/opt/panel/app
ExecStart=/opt/panel/venv/bin/uvicorn panel.app:app --host 127.0.0.1 --port 8000 --log-level warning
Restart=always
RestartSec=2
TimeoutStopSec=10
MemoryMax=1G
NoNewPrivileges=yes
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/opt/panel /var/lib/fleet

[Install]
WantedBy=multi-user.target
