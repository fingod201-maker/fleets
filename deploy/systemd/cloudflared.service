# Host-default cloudflared unit (token-file based). On this shared host another
# tenant already owns this unit; deploy.sh restores this exact shape and runs the
# fleet tunnel under fleet-cloudflared.service instead.
[Unit]
Description=cloudflared tunnel
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
ExecStart=/usr/local/bin/cloudflared --no-autoupdate tunnel run --token-file /etc/cloudflared/token
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
