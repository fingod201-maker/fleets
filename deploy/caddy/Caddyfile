{
	email __EMAIL__
	admin off
}

# Loopback reverse proxy only. Public TLS is terminated by the Cloudflare Tunnel
# (origin :8000). :443 on the host is reserved for the durable Sliver mTLS C2.
http://127.0.0.1:8080 {
	encode gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
	}
	reverse_proxy 127.0.0.1:8000
	log {
		output file /var/log/caddy/panel.log
		format json
	}
}
